# RUN: llc -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=ventus-sgpr-simt-checker %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: sgpr_join_reload_is_not_clobber

--- |
  target triple = "riscv32"

  define void @sgpr_join_reload_is_not_clobber() {
    ret void
  }
...
---
name:            sgpr_join_reload_is_not_clobber
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4, stack-id: sgpr-spill }
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $v0, $v1, $x7

    VBEQ $v0, $v1, %bb.2, implicit-def dead $x6
    PseudoBR %bb.1

  bb.1:
    successors: %bb.2

    $x7 = LW %stack.0, 0 :: (load (s32) from %stack.0, addrspace 5)
    PseudoBR %bb.2

  bb.2:
    liveins: $v0, $x7

    $v2 = VADD_VX $v0, $x7
    PseudoRET
...
