# RUN: not --crash llc -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=ventus-sgpr-simt-checker %s -o /dev/null 2>&1 | FileCheck %s

# CHECK: Ventus SGPR SIMT sibling clobber in function 'sgpr_diamond_reload_does_not_hide_clobber'
# CHECK: register $x7 is used as live-in in sibling block
# CHECK: sibling def: {{.*}}$x7 = LW $x2, 0

--- |
  target triple = "riscv32"

  define void @sgpr_diamond_reload_does_not_hide_clobber() {
    ret void
  }
...
---
name:            sgpr_diamond_reload_does_not_hide_clobber
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4, stack-id: sgpr-spill }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $v0, $v1, $x7

    VBLT $v0, $v1, %bb.1, implicit-def dead $x6
    PseudoBR %bb.2

  bb.1:
    successors: %bb.6
    liveins: $v0, $x7

    $v2 = VADD_VX $v0, killed $x7
    PseudoBR %bb.6

  bb.2:
    successors: %bb.3, %bb.4
    liveins: $v0, $v1

    VBEQ $v0, $v1, %bb.3, implicit-def dead $x6
    PseudoBR %bb.4

  bb.3:
    successors: %bb.5

    $x7 = LW $x2, 0 :: (load (s32))
    PseudoBR %bb.5

  bb.4:
    successors: %bb.5

    $x7 = LW %stack.0, 0 :: (load (s32) from %stack.0, addrspace 5)
    PseudoBR %bb.5

  bb.5:
    successors: %bb.6
    liveins: $x7

    PseudoBR %bb.6

  bb.6:
    liveins: $v2, $x7

    PseudoRET
...
