; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mcpu=ventus-gpgpu -verify-machineinstrs < %s \
; RUN:   | FileCheck -check-prefix=VENTUS %s

;; The Ventus POCL driver packs every by-value kernel argument at an offset
;; aligned to its size rounded up to a power of two. For struct { float, float }
;; (size 8, ABI alignment 4) after a pointer, the driver writes the struct at
;; offset 8, so the kernel must load the fields from 8(a0) and 12(a0).

%struct.f2 = type { float, float }

define dso_local ventus_kernel void @fill(ptr addrspace(1) nocapture noundef writeonly align 4 %out, %struct.f2 %v) {
; VENTUS-LABEL: fill:
; VENTUS:       # %bb.0: # %entry
; VENTUS-NEXT:    lw t0, 0(a0)
; VENTUS-NEXT:    lw t1, 8(a0)
; VENTUS-NEXT:    lw t2, 12(a0)
; VENTUS-NEXT:    sw t1, 0(t0)
; VENTUS-NEXT:    sw t2, 4(t0)
; VENTUS-NEXT:    ret
entry:
  %x = extractvalue %struct.f2 %v, 0
  %y = extractvalue %struct.f2 %v, 1
  store float %x, ptr addrspace(1) %out, align 4
  %p1 = getelementptr inbounds float, ptr addrspace(1) %out, i32 1
  store float %y, ptr addrspace(1) %p1, align 4
  ret void
}
