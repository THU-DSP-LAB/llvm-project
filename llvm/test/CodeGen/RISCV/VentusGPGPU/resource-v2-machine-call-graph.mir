machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
  isEntryFunction: false
body:             |
  bb.0.entry:
    ADJCALLSTACKUP 32, 0, implicit-def dead $x2, implicit-def dead $x4, implicit $x2, implicit $x4
    PseudoCALL target-flags(riscv-call) @leaf, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2, implicit-def $x4
    ADJCALLSTACKDOWN 32, 0, implicit-def dead $x2, implicit-def dead $x4, implicit $x2, implicit $x4
    PseudoRET
