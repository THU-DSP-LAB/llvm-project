# RUN: not --crash llc -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=ventus-sgpr-simt-checker %s -o /dev/null 2>&1 | FileCheck %s

# CHECK: Ventus SGPR SIMT sibling clobber in function 'sgpr_direct_join_clobber'
# CHECK: register $x7 is used as live-in in sibling block #2 but defined in sibling block #1
# CHECK: live-in use: {{.*}}PseudoSGPRKeepAlive $x7
# CHECK: sibling def:

--- |
  target triple = "riscv32"

  define void @sgpr_direct_join_clobber() {
    ret void
  }
...
---
name:            sgpr_direct_join_clobber
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $v0, $v1, $x7

    VBEQ $v0, $v1, %bb.2, implicit-def dead $x6
    PseudoBR %bb.1

  bb.1:
    successors: %bb.2

    $x7 = LW $x2, 0 :: (load (s32))
    PseudoBR %bb.2

  bb.2:
    liveins: $v0, $x7

    PseudoSGPRKeepAlive $x7
    $v2 = VADD_VX $v0, $x7
    PseudoRET
...
