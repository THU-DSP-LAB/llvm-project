# RUN: llc -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=ventus-broadcast-copy-propagation %s -o - | FileCheck %s

# CHECK-LABEL: name: physical_broadcast_clobber
# CHECK: %0:vgpr = VMV_V_X $x5
# CHECK: $x5 = ADDI $x0, 1
# CHECK: %1:gpr = COPY %0

--- |
  target triple = "riscv32"

  define void @physical_broadcast_clobber() {
    ret void
  }
...
---
name:            physical_broadcast_clobber
tracksRegLiveness: true
registers:
  - { id: 0, class: vgpr }
  - { id: 1, class: gpr }
liveins:
  - { reg: '$x5' }
body:             |
  bb.0:
    liveins: $x5

    %0:vgpr = VMV_V_X $x5
    $x5 = ADDI $x0, 1
    %1:gpr = COPY %0
    PseudoRET
...
