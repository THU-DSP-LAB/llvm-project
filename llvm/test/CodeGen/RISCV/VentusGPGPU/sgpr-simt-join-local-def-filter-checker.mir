# RUN: llc -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=ventus-sgpr-simt-checker %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: sgpr_join_local_def_filters_non_sgpr_defs

--- |
  target triple = "riscv32"

  define void @sgpr_join_local_def_filters_non_sgpr_defs() {
    ret void
  }
...
---
name:            sgpr_join_local_def_filters_non_sgpr_defs
tracksRegLiveness: true
registers:
  - { id: 0, class: vgpr }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $v0, $v1, $x7

    VBEQ $v0, $v1, %bb.1, implicit-def dead $x6
    PseudoBR %bb.2

  bb.1:
    successors: %bb.3

    $x8 = ADDI $x0, 1
    PseudoBR %bb.3

  bb.2:
    successors: %bb.3

    $x9 = ADDI $x0, 2
    PseudoBR %bb.3

  bb.3:
    liveins: $v0, $x7

    %0:vgpr = IMPLICIT_DEF
    $v2 = VADD_VX $v0, $x7
    PseudoRET
...
