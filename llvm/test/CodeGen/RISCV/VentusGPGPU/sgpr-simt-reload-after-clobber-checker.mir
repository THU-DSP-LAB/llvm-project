# RUN: not --crash llc -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=ventus-sgpr-simt-checker %s -o /dev/null 2>&1 | FileCheck %s

# CHECK: Ventus SGPR SIMT sibling clobber in function 'sgpr_clobber_after_reload'
# CHECK: register $x7 is used as live-in in sibling block #1 but defined in sibling block #2
# CHECK: sibling def: {{.*}}ADDI

--- |
  target triple = "riscv32"

  define void @sgpr_clobber_after_reload() {
    ret void
  }
...
---
name:            sgpr_clobber_after_reload
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4, stack-id: sgpr-spill }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $v0, $v1, $x7

    VBLT $v0, $v1, %bb.1, implicit-def dead $x6
    PseudoBR %bb.2

  bb.1:
    successors: %bb.3
    liveins: $v0, $x7

    $v2 = VADD_VX $v0, killed $x7
    PseudoBR %bb.3

  bb.2:
    successors: %bb.3

    $x7 = LW %stack.0, 0 :: (load (s32) from %stack.0, addrspace 5)
    $x7 = ADDI $x0, 1
    PseudoBR %bb.3

  bb.3:
    liveins: $v2, $x7

    PseudoRET
...
