# RUN: llc -mtriple=riscv32 -mcpu=ventus-gpgpu -filetype=obj %s -o /dev/null
# RUN: llc -mtriple=riscv32 -mcpu=ventus-gpgpu %s -o - | FileCheck %s

--- |
  target triple = "riscv32"

  define void @imm11_size_relaxes_vbranch() {
    ret void
  }
...
---
name: imm11_size_relaxes_vbranch
tracksRegLiveness: true
selected: true
body: |
  ; The conditional target is out of range only when the IMM11 pseudo is
  ; correctly counted as its REGEXTI plus vector instruction expansion.
  ; CHECK-LABEL: imm11_size_relaxes_vbranch:
  ; CHECK: vbne v0, v1, .LBB0_1
  ; CHECK-NEXT: j .LBB0_2
  ; CHECK: .LBB0_1:
  ; CHECK: regexti zero, zero, 0
  ; CHECK-NEXT: vand.vi v2, v0, -1
  bb.0:
    successors: %bb.2(0x40000000), %bb.1(0x40000000)
    liveins: $v0, $v1

    VBEQ $v0, $v1, %bb.2, implicit-def $x6
    PseudoBR %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $v0

    $v2 = PseudoVAND_VI_IMM11 $v0, 31
    INLINEASM &".space 4076", 1
    PseudoBR %bb.2

  bb.2:
    PseudoRET
...
