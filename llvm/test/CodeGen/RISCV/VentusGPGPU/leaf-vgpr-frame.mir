# RUN: llc -x mir -mtriple=riscv32 -mcpu=ventus-gpgpu -run-pass=prologepilog \
# RUN:   -simplify-mir -verify-machineinstrs %s -o - | FileCheck %s

# A callee-saved VGPR creates a private frame even in a leaf with no generic
# frame objects or calls. Check both sides of the frame and the private base.
# CHECK-LABEL: name: leaf_saved_vgpr
# CHECK:      $x4 = frame-setup ADDI $x4, 12
# CHECK:      $v32 = VMV_V_X $x4
# CHECK:      VSW killed $v33, $v32, -12
# CHECK:      $v33 = VMV_V_X $x10
# CHECK:      $v33 = VLW $v32, -12
# CHECK:      $x4 = frame-destroy ADDI $x4, -12
# CHECK:      $v32 = VMV_V_X $x4
# CHECK:      PseudoRET

# A genuinely frameless leaf still needs no stack or private-base adjustment.
# CHECK-LABEL: name: frameless_leaf
# CHECK:      bb.0:
# CHECK-NOT:  ADDI
# CHECK-NOT:  VMV_V_X
# CHECK:      PseudoRET

--- |
  target datalayout = "e-m:e-p:32:32-i64:64-n32-S128-A5-G1"
  target triple = "riscv32"
  define void @leaf_saved_vgpr() #0 { ret void }
  define void @frameless_leaf() #0 { ret void }
  attributes #0 = { "target-cpu"="ventus-gpgpu" }
...
---
name: leaf_saved_vgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    $v33 = VMV_V_X $x10
    PseudoRET
...
---
name: frameless_leaf
tracksRegLiveness: true
body: |
  bb.0:
    PseudoRET
...
