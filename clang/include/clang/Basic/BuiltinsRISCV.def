VENTUS_BUILTIN(vgelu_approx_bf16x2, "UiUi")
VENTUS_BUILTIN(vsilu_approx_bf16x2, "UiUi")
#undef VENTUS_BUILTIN

// MMA builtins. The software ABI uses tuple/vector window types while the hardware
// instruction still encodes only the base VGPR of each contiguous window.
TARGET_BUILTIN(__builtin_riscv_ventus_mma_m8n8k16_row_row_f32_f16_f16_f32,
