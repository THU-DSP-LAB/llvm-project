//
// This file defines the RISC-V-specific builtin function database.  Users of
// this file must define the BUILTIN macro to make use of this information.
//
//===----------------------------------------------------------------------===//

#if defined(BUILTIN) && !defined(TARGET_BUILTIN)
#define TARGET_BUILTIN(ID, TYPE, ATTRS, FEATURE) BUILTIN(ID, TYPE, ATTRS)
#endif

//===----------------------------------------------------------------------===//
// Ventus OpenCL builtins.
//===----------------------------------------------------------------------===//

// Barrier function builtins
TARGET_BUILTIN(barrier, "vi", "n", "32bit")
TARGET_BUILTIN(work_group_barrier, "vi.", "n", "32bit")
TARGET_BUILTIN(sub_group_barrier, "vi.", "n", "32bit")

// FPU/SFU builtins.
#define VENTUS_BUILTIN(NAME, TYPE) TARGET_BUILTIN(__builtin_riscv_ventus_##NAME, TYPE, "nc", "32bit")
VENTUS_BUILTIN(shuffle_idx_i32, "UiUiIUi")
VENTUS_BUILTIN(shuffle_up_i32, "UiUiIUi")
VENTUS_BUILTIN(shuffle_down_i32, "UiUiIUi")
VENTUS_BUILTIN(shuffle_bfly_i32, "UiUiIUi")
VENTUS_BUILTIN(vcvt_fp32_fp16, "fUi")
VENTUS_BUILTIN(vcvt_fp16_fp32, "Uif")
VENTUS_BUILTIN(vcvt_fp32_bf16, "fUi")
VENTUS_BUILTIN(vcvt_bf16_fp32, "Uif")
VENTUS_BUILTIN(vadd_f16x2, "UiUiUi")
VENTUS_BUILTIN(vmul_f16x2, "UiUiUi")
VENTUS_BUILTIN(vfma_f16x2, "UiUiUiUi")
VENTUS_BUILTIN(vadd_bf16x2, "UiUiUi")
VENTUS_BUILTIN(vmul_bf16x2, "UiUiUi")
VENTUS_BUILTIN(vfma_bf16x2, "UiUiUiUi")
VENTUS_BUILTIN(vex2_approx_f32, "ff")
VENTUS_BUILTIN(vlg2_approx_f32, "ff")
VENTUS_BUILTIN(vrcp_approx_f32, "ff")
VENTUS_BUILTIN(vsqrt_approx_f32, "ff")
VENTUS_BUILTIN(vrsqrt_approx_f32, "ff")
VENTUS_BUILTIN(vsin_approx_f32, "ff")
VENTUS_BUILTIN(vcos_approx_f32, "ff")
VENTUS_BUILTIN(vtanh_approx_f32, "ff")
VENTUS_BUILTIN(vgelu_approx_f32, "ff")
VENTUS_BUILTIN(vsilu_approx_f32, "ff")
VENTUS_BUILTIN(vex2_approx_f16x2, "UiUi")
VENTUS_BUILTIN(vrcp_approx_f16x2, "UiUi")
VENTUS_BUILTIN(vsqrt_approx_f16x2, "UiUi")
VENTUS_BUILTIN(vrsqrt_approx_f16x2, "UiUi")
VENTUS_BUILTIN(vtanh_approx_f16x2, "UiUi")
VENTUS_BUILTIN(vgelu_approx_f16x2, "UiUi")
VENTUS_BUILTIN(vsilu_approx_f16x2, "UiUi")
